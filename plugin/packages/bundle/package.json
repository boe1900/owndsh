{
  "name": "owndsh-plugin",
  "version": "0.1.0",
  "description": "Self-hosted enterprise control plane plugin for DeepSeek Harness",
  "keywords": ["deepseek", "harness", "self-hosted", "enterprise", "ai"],
  "homepage": "https://github.com/boe1900/owndsh#readme",
  "bugs": "https://github.com/boe1900/owndsh/issues",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/boe1900/owndsh.git",
    "directory": "plugin/packages/bundle"
  },
  "publishConfig": {
    "access": "public",
    "tag": "next"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": "./lib/client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/index.js.map",
    "lib/client.js",
    "lib/client.js.map",
    "lib/types/**/*.d.ts",
    "lib/types/**/*.d.ts.map",
    "cordis.patch.yml",
    "README.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-ui-sidebar",
        "@deepseek-ai/dsh-client-ui-settings-general"
      ]
    }
  },
  "scripts": {
    "build": "pnpm --filter owndsh-plugin^... run build && node scripts/build.mjs",
    "typecheck": "pnpm --filter owndsh-plugin^... run build && tsc -p tsconfig.json --noEmit",
    "test": "vitest run tests",
    "pack": "pnpm pack"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-credentials": "^0.1.1-rc.2",
    "@deepseek-ai/dsh-host-plugin-inventory": "^0.1.1-rc.2",
    "@deepseek-ai/dsh-llm": "^0.1.1-rc.2",
    "@deepseek-ai/dsh-llm-pi-ai": "^0.1.1-rc.2",
    "@deepseek-ai/dsh-settings": "^0.1.1-rc.2",
    "@deepseek-ai/dsh-subprocess": "^0.1.1-rc.2",
    "@deepseek-ai/schemastery": "^3.18.1"
  },
  "devDependencies": {
    "@deepseek-ai/dsh-credentials": "0.1.1-rc.2",
    "@deepseek-ai/dsh-host-plugin-inventory": "0.1.1-rc.2",
    "@deepseek-ai/dsh-llm": "0.1.1-rc.2",
    "@deepseek-ai/dsh-llm-pi-ai": "0.1.1-rc.2",
    "@deepseek-ai/dsh-settings": "0.1.1-rc.2",
    "@deepseek-ai/dsh-subprocess": "0.1.1-rc.2",
    "@deepseek-ai/schemastery": "3.18.1",
    "@owndsh/llm-gateway": "workspace:*",
    "@owndsh/platform-client": "workspace:*",
    "@owndsh/plugin-distribution": "workspace:*",
    "@owndsh/ui": "workspace:*"
  }
}

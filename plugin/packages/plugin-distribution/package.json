{
  "name": "@owndsh/plugin-distribution",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    }
  },
  "files": [
    "lib",
    "README.md"
  ],
  "scripts": {
    "build": "pnpm --filter @owndsh/plugin-distribution^... run build && tsc -p tsconfig.json",
    "typecheck": "pnpm --filter @owndsh/plugin-distribution^... run build && tsc -p tsconfig.json --noEmit",
    "test": "vitest run tests"
  },
  "dependencies": {
    "@owndsh/contracts": "workspace:*",
    "@owndsh/platform-client": "workspace:*"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.4",
    "@deepseek-ai/dsh-plugin-manager": "^0.1.7-rc.1",
    "@deepseek-ai/dsh-host-plugin-inventory": "^0.1.7-rc.1"
  },
  "devDependencies": {
    "@deepseek-ai/dsh-plugin-manager": "0.1.7-rc.1",
    "@deepseek-ai/dsh-host-plugin-inventory": "0.1.7-rc.1"
  }
}

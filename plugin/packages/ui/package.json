{
  "name": "@owndsh/ui",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": {
      "types": "./lib/client.d.ts",
      "default": "./lib/client.js"
    }
  },
  "files": [
    "lib",
    "README.md"
  ],
  "scripts": {
    "build": "pnpm --filter @owndsh/ui^... run build && tsc -p tsconfig.json",
    "typecheck": "pnpm --filter @owndsh/ui^... run build && tsc -p tsconfig.json --noEmit",
    "test": "vitest run tests"
  },
  "peerDependencies": {
    "react": "^18.2.0"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "4.0.5",
    "@deepseek-ai/dsh-api-remotes": "0.2.1-rc.3",
    "@deepseek-ai/dsh-client-store": "0.2.1-rc.3",
    "@deepseek-ai/dsh-client-ui-primitives": "0.2.1-rc.3",
    "@deepseek-ai/dsh-util-crypto": "0.2.1-rc.3",
    "@types/mdast": "4.0.4"
  },
  "dependencies": {
    "@owndsh/contracts": "workspace:*"
  }
}

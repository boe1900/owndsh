{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:enterprise-agent:contracts:MyQuotaUsageResponse",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "data",
    "requestId"
  ],
  "properties": {
    "data": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "policyId",
          "name",
          "scope",
          "subjectId",
          "daily",
          "monthly",
          "rpm",
          "concurrency"
        ],
        "properties": {
          "policyId": {
            "type": "string",
            "pattern": "^[1-9][0-9]{0,18}$"
          },
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 120
          },
          "scope": {
            "type": "string",
            "enum": [
              "DEFAULT",
              "DEPT",
              "USER"
            ]
          },
          "subjectId": {
            "oneOf": [
              {
                "type": "string",
                "pattern": "^[1-9][0-9]{0,18}$"
              },
              {
                "type": "null"
              }
            ]
          },
          "daily": {
            "oneOf": [
              {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "limit",
                  "usedTokens",
                  "reservedTokens",
                  "resetsAt"
                ],
                "properties": {
                  "limit": {
                    "type": "integer",
                    "format": "int64",
                    "minimum": 1
                  },
                  "usedTokens": {
                    "type": "integer",
                    "format": "int64",
                    "minimum": 0
                  },
                  "reservedTokens": {
                    "type": "integer",
                    "format": "int64",
                    "minimum": 0
                  },
                  "resetsAt": {
                    "type": "string",
                    "format": "date-time"
                  }
                }
              },
              {
                "type": "null"
              }
            ]
          },
          "monthly": {
            "oneOf": [
              {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "limit",
                  "usedTokens",
                  "reservedTokens",
                  "resetsAt"
                ],
                "properties": {
                  "limit": {
                    "type": "integer",
                    "format": "int64",
                    "minimum": 1
                  },
                  "usedTokens": {
                    "type": "integer",
                    "format": "int64",
                    "minimum": 0
                  },
                  "reservedTokens": {
                    "type": "integer",
                    "format": "int64",
                    "minimum": 0
                  },
                  "resetsAt": {
                    "type": "string",
                    "format": "date-time"
                  }
                }
              },
              {
                "type": "null"
              }
            ]
          },
          "rpm": {
            "oneOf": [
              {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "limit",
                  "current",
                  "resetsAt"
                ],
                "properties": {
                  "limit": {
                    "type": "integer",
                    "minimum": 1
                  },
                  "current": {
                    "type": "integer",
                    "minimum": 0
                  },
                  "resetsAt": {
                    "type": "string",
                    "format": "date-time"
                  }
                }
              },
              {
                "type": "null"
              }
            ]
          },
          "concurrency": {
            "oneOf": [
              {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "limit",
                  "current"
                ],
                "properties": {
                  "limit": {
                    "type": "integer",
                    "minimum": 1
                  },
                  "current": {
                    "type": "integer",
                    "minimum": 0
                  }
                }
              },
              {
                "type": "null"
              }
            ]
          }
        }
      }
    },
    "requestId": {
      "type": "string",
      "description": "Server-generated req_ prefix followed by one canonical ULID.",
      "pattern": "^req_[0-9A-HJKMNP-TV-Z]{26}$",
      "examples": [
        "req_01ARZ3NDEKTSV4RRFFQ69G5FAV"
      ]
    }
  }
}

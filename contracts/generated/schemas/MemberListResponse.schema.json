{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:enterprise-agent:contracts:MemberListResponse",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "data",
    "requestId"
  ],
  "properties": {
    "data": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "items",
        "page"
      ],
      "properties": {
        "items": {
          "type": "array",
          "maxItems": 200,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "username",
              "displayName",
              "status",
              "roles",
              "loginMethods",
              "lastActiveAt",
              "revision"
            ],
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[1-9][0-9]{0,18}$",
                "description": "Enterprise user snowflake ID serialized as a string."
              },
              "username": {
                "type": "string",
                "minLength": 1,
                "maxLength": 30
              },
              "displayName": {
                "type": "string",
                "minLength": 1,
                "maxLength": 30
              },
              "status": {
                "type": "string",
                "enum": [
                  "ACTIVE",
                  "DISABLED"
                ]
              },
              "roles": {
                "type": "array",
                "maxItems": 5,
                "uniqueItems": true,
                "items": {
                  "type": "string",
                  "enum": [
                    "enterprise_admin",
                    "model_admin",
                    "plugin_admin",
                    "auditor",
                    "employee"
                  ]
                }
              },
              "loginMethods": {
                "type": "array",
                "maxItems": 20,
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "sourceId",
                    "sourceName",
                    "sourceType",
                    "lastLoginAt"
                  ],
                  "properties": {
                    "sourceId": {
                      "oneOf": [
                        {
                          "type": "string",
                          "pattern": "^[1-9][0-9]{0,18}$",
                          "description": "Identity source snowflake ID serialized as a string."
                        },
                        {
                          "type": "null"
                        }
                      ]
                    },
                    "sourceName": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 100
                    },
                    "sourceType": {
                      "type": "string",
                      "enum": [
                        "OIDC",
                        "LDAP",
                        "LOCAL"
                      ]
                    },
                    "lastLoginAt": {
                      "oneOf": [
                        {
                          "type": "string",
                          "format": "date-time"
                        },
                        {
                          "type": "null"
                        }
                      ]
                    }
                  }
                }
              },
              "lastActiveAt": {
                "oneOf": [
                  {
                    "type": "string",
                    "format": "date-time"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "revision": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991,
                "description": "Monotonic compare-and-swap revision safe in JavaScript.",
                "examples": [
                  7
                ]
              }
            }
          }
        },
        "page": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "hasMore",
            "limit",
            "nextCursor"
          ],
          "properties": {
            "hasMore": {
              "type": "boolean"
            },
            "limit": {
              "type": "integer",
              "minimum": 1,
              "maximum": 200,
              "default": 50
            },
            "nextCursor": {
              "oneOf": [
                {
                  "type": "string",
                  "minLength": 16,
                  "maxLength": 512,
                  "pattern": "^[A-Za-z0-9_-]+$",
                  "description": "Server-signed opaque cursor."
                },
                {
                  "type": "null"
                }
              ]
            }
          }
        }
      }
    },
    "requestId": {
      "type": "string",
      "description": "Server-generated req_ prefix followed by one canonical ULID.",
      "pattern": "^req_[0-9A-HJKMNP-TV-Z]{26}$",
      "examples": [
        "req_01ARZ3NDEKTSV4RRFFQ69G5FAV"
      ]
    }
  }
}

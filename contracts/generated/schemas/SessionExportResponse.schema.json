{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:owndsh:contracts:SessionExportResponse",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "data",
    "requestId"
  ],
  "properties": {
    "data": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sessionId",
        "header",
        "title",
        "fromSeq",
        "toSeq",
        "eventCount",
        "previousRollingHash",
        "rollingHash",
        "payloadSha256",
        "payloadBase64",
        "hasMore"
      ],
      "properties": {
        "sessionId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "header": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "version",
            "id",
            "createdAt"
          ],
          "properties": {
            "version": {
              "type": "integer",
              "const": 0
            },
            "id": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128
            },
            "createdAt": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "cwd": {
              "type": "string",
              "minLength": 1,
              "maxLength": 4096
            },
            "parentSession": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128
            },
            "seedLength": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "origin": {
              "type": "string",
              "const": "subagent"
            },
            "delegationDepth": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "agentPreset": {
              "type": "string",
              "minLength": 1,
              "maxLength": 255
            }
          }
        },
        "title": {
          "oneOf": [
            {
              "type": "string",
              "maxLength": 512
            },
            {
              "type": "null"
            }
          ]
        },
        "fromSeq": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "toSeq": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "eventCount": {
          "type": "integer",
          "minimum": 1,
          "maximum": 200
        },
        "previousRollingHash": {
          "type": "string",
          "minLength": 44,
          "maxLength": 44,
          "pattern": "^[A-Za-z0-9+/]{43}=$"
        },
        "rollingHash": {
          "type": "string",
          "minLength": 44,
          "maxLength": 44,
          "pattern": "^[A-Za-z0-9+/]{43}=$"
        },
        "payloadSha256": {
          "type": "string",
          "minLength": 44,
          "maxLength": 44,
          "pattern": "^[A-Za-z0-9+/]{43}=$"
        },
        "payloadBase64": {
          "type": "string",
          "minLength": 4,
          "pattern": "^[A-Za-z0-9+/]+={0,2}$"
        },
        "hasMore": {
          "type": "boolean"
        }
      }
    },
    "requestId": {
      "type": "string",
      "description": "Server-generated req_ prefix followed by one canonical ULID.",
      "pattern": "^req_[0-9A-HJKMNP-TV-Z]{26}$",
      "examples": [
        "req_01ARZ3NDEKTSV4RRFFQ69G5FAV"
      ]
    }
  }
}

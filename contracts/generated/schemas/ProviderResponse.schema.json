{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:enterprise-agent:contracts:ProviderResponse",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "data",
    "requestId"
  ],
  "properties": {
    "data": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "name",
        "providerType",
        "baseUrl",
        "credentialConfigured",
        "status",
        "connectTimeoutMs",
        "readTimeoutMs",
        "revision"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[1-9][0-9]{0,18}$"
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "providerType": {
          "type": "string",
          "enum": [
            "DEEPSEEK_OPENAI"
          ]
        },
        "baseUrl": {
          "type": "string",
          "format": "uri",
          "minLength": 1,
          "maxLength": 500
        },
        "credentialConfigured": {
          "type": "boolean"
        },
        "status": {
          "type": "string",
          "enum": [
            "ACTIVE",
            "DISABLED"
          ]
        },
        "connectTimeoutMs": {
          "type": "integer",
          "minimum": 1,
          "maximum": 600000
        },
        "readTimeoutMs": {
          "type": "integer",
          "minimum": 1,
          "maximum": 600000
        },
        "revision": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991,
          "description": "Monotonic compare-and-swap revision safe in JavaScript.",
          "examples": [
            7
          ]
        }
      }
    },
    "requestId": {
      "type": "string",
      "description": "Server-generated req_ prefix followed by one canonical ULID.",
      "pattern": "^req_[0-9A-HJKMNP-TV-Z]{26}$",
      "examples": [
        "req_01ARZ3NDEKTSV4RRFFQ69G5FAV"
      ]
    }
  }
}

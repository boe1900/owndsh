{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:enterprise-agent:contracts:LdapDirectoryGroupSearchResponse",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "data",
    "requestId"
  ],
  "properties": {
    "data": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "items"
      ],
      "properties": {
        "items": {
          "type": "array",
          "maxItems": 50,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "externalGroup",
              "displayName"
            ],
            "properties": {
              "externalGroup": {
                "type": "string",
                "minLength": 1,
                "maxLength": 1024,
                "description": "Group DN used as the explicit mapping key."
              },
              "displayName": {
                "type": "string",
                "minLength": 1,
                "maxLength": 256
              }
            }
          }
        }
      }
    },
    "requestId": {
      "type": "string",
      "description": "Server-generated req_ prefix followed by one canonical ULID.",
      "pattern": "^req_[0-9A-HJKMNP-TV-Z]{26}$",
      "examples": [
        "req_01ARZ3NDEKTSV4RRFFQ69G5FAV"
      ]
    }
  }
}

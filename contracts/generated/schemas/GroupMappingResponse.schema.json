{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:owndsh:contracts:GroupMappingResponse",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "data",
    "requestId"
  ],
  "properties": {
    "data": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "sourceId",
        "externalGroup",
        "accessGroupId",
        "revision"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[1-9][0-9]{0,18}$",
          "description": "External group mapping snowflake ID serialized as a string."
        },
        "sourceId": {
          "type": "string",
          "pattern": "^[1-9][0-9]{0,18}$",
          "description": "Identity source snowflake ID serialized as a string."
        },
        "externalGroup": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        },
        "accessGroupId": {
          "type": "string",
          "pattern": "^[1-9][0-9]{0,18}$",
          "description": "Product access group snowflake ID serialized as a string."
        },
        "revision": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991,
          "description": "Monotonic compare-and-swap revision safe in JavaScript.",
          "examples": [
            7
          ]
        }
      }
    },
    "requestId": {
      "type": "string",
      "description": "Server-generated req_ prefix followed by one canonical ULID.",
      "pattern": "^req_[0-9A-HJKMNP-TV-Z]{26}$",
      "examples": [
        "req_01ARZ3NDEKTSV4RRFFQ69G5FAV"
      ]
    }
  }
}

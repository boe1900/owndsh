{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:enterprise-agent:contracts:EnterpriseErrorResponse",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "error"
  ],
  "properties": {
    "error": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "code",
        "message",
        "requestId",
        "retryable"
      ],
      "properties": {
        "code": {
          "type": "string",
          "enum": [
            "ENT_INVALID_REQUEST",
            "ENT_INVALID_REDIRECT_URI",
            "ENT_PKCE_REQUIRED",
            "ENT_PLUGIN_ARTIFACT_INVALID",
            "ENT_SESSION_FORMAT_UNSUPPORTED",
            "ENT_AUTH_REQUIRED",
            "ENT_AUTH_CODE_INVALID",
            "ENT_PKCE_INVALID",
            "ENT_AUTH_SESSION_EXPIRED",
            "ENT_PERMISSION_DENIED",
            "ENT_DEVICE_REVOKED",
            "ENT_MODEL_NOT_ASSIGNED",
            "ENT_PLUGIN_NOT_ASSIGNED",
            "ENT_RESOURCE_NOT_OWNED",
            "ENT_RESOURCE_NOT_FOUND",
            "ENT_SESSION_CONTENT_EXPIRED",
            "ENT_REVISION_CONFLICT",
            "ENT_REQUEST_IN_PROGRESS",
            "ENT_REQUEST_ALREADY_COMPLETED",
            "ENT_SESSION_SEQ_GAP",
            "ENT_SESSION_DIVERGED",
            "ENT_SESSION_SOURCE_DEVICE_CONFLICT",
            "ENT_IDENTITY_ALREADY_LINKED",
            "ENT_REQUEST_TOO_LARGE",
            "ENT_PLUGIN_ARCHIVE_TOO_LARGE",
            "ENT_SESSION_BATCH_TOO_LARGE",
            "ENT_QUOTA_DAILY_EXCEEDED",
            "ENT_QUOTA_MONTHLY_EXCEEDED",
            "ENT_QUOTA_RPM_EXCEEDED",
            "ENT_QUOTA_CONCURRENCY_EXCEEDED",
            "ENT_UPSTREAM_AUTH_FAILED",
            "ENT_UPSTREAM_INVALID_RESPONSE",
            "ENT_PLATFORM_UNAVAILABLE",
            "ENT_UPSTREAM_UNAVAILABLE",
            "ENT_UPSTREAM_TIMEOUT"
          ]
        },
        "message": {
          "type": "string",
          "minLength": 1,
          "maxLength": 500
        },
        "requestId": {
          "type": "string",
          "description": "Server-generated req_ prefix followed by one canonical ULID.",
          "pattern": "^req_[0-9A-HJKMNP-TV-Z]{26}$",
          "examples": [
            "req_01ARZ3NDEKTSV4RRFFQ69G5FAV"
          ]
        },
        "retryable": {
          "type": "boolean"
        },
        "details": {
          "oneOf": [
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "violations"
              ],
              "properties": {
                "violations": {
                  "type": "array",
                  "minItems": 1,
                  "maxItems": 50,
                  "items": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                      "field",
                      "reason"
                    ],
                    "properties": {
                      "field": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 128
                      },
                      "reason": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 256
                      }
                    }
                  }
                }
              }
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "actualRevision",
                "expectedRevision"
              ],
              "properties": {
                "actualRevision": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 9007199254740991,
                  "description": "Monotonic compare-and-swap revision safe in JavaScript.",
                  "examples": [
                    7
                  ]
                },
                "expectedRevision": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 9007199254740991,
                  "description": "Monotonic compare-and-swap revision safe in JavaScript.",
                  "examples": [
                    7
                  ]
                }
              }
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "policyId",
                "resetsAt"
              ],
              "properties": {
                "policyId": {
                  "type": "string",
                  "pattern": "^[1-9][0-9]{0,18}$"
                },
                "resetsAt": {
                  "type": "string",
                  "format": "date-time"
                }
              }
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "originalRequestId",
                "result"
              ],
              "properties": {
                "originalRequestId": {
                  "type": "string",
                  "description": "Server-generated req_ prefix followed by one canonical ULID.",
                  "pattern": "^req_[0-9A-HJKMNP-TV-Z]{26}$",
                  "examples": [
                    "req_01ARZ3NDEKTSV4RRFFQ69G5FAV"
                  ]
                },
                "result": {
                  "type": "string",
                  "enum": [
                    "IN_PROGRESS",
                    "COMPLETED"
                  ]
                }
              }
            }
          ]
        }
      }
    }
  }
}

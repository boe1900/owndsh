{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:owndsh:contracts:ExternalIdentitySummaryResponse",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "data",
    "requestId"
  ],
  "properties": {
    "data": {
      "type": "array",
      "maxItems": 32,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "sourceId",
          "sourceName",
          "sourceType",
          "externalSubject",
          "lastLoginAt"
        ],
        "properties": {
          "sourceId": {
            "type": "string",
            "pattern": "^[1-9][0-9]{0,18}$",
            "description": "Identity source snowflake ID serialized as a string."
          },
          "sourceName": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100
          },
          "sourceType": {
            "type": "string",
            "enum": [
              "OIDC",
              "LDAP",
              "LOCAL"
            ]
          },
          "externalSubject": {
            "type": "string",
            "minLength": 1,
            "maxLength": 512
          },
          "lastLoginAt": {
            "oneOf": [
              {
                "type": "string",
                "format": "date-time"
              },
              {
                "type": "null"
              }
            ]
          }
        }
      }
    },
    "requestId": {
      "type": "string",
      "description": "Server-generated req_ prefix followed by one canonical ULID.",
      "pattern": "^req_[0-9A-HJKMNP-TV-Z]{26}$",
      "examples": [
        "req_01ARZ3NDEKTSV4RRFFQ69G5FAV"
      ]
    }
  }
}

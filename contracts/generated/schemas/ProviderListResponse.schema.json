{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:enterprise-agent:contracts:ProviderListResponse",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "data",
    "requestId"
  ],
  "properties": {
    "data": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "items",
        "page"
      ],
      "properties": {
        "items": {
          "type": "array",
          "maxItems": 200,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "providerKey",
              "name",
              "providerType",
              "apiProtocol",
              "baseUrl",
              "credentialConfigured",
              "status",
              "connectTimeoutMs",
              "readTimeoutMs",
              "revision"
            ],
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[1-9][0-9]{0,18}$"
              },
              "providerKey": {
                "type": "string",
                "minLength": 1,
                "maxLength": 120,
                "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$"
              },
              "name": {
                "type": "string",
                "minLength": 1,
                "maxLength": 120
              },
              "providerType": {
                "type": "string",
                "enum": [
                  "DEEPSEEK_OFFICIAL",
                  "CUSTOM"
                ]
              },
              "apiProtocol": {
                "type": "string",
                "enum": [
                  "openai-completions",
                  "openai-responses",
                  "anthropic-messages"
                ]
              },
              "baseUrl": {
                "type": "string",
                "format": "uri",
                "minLength": 1,
                "maxLength": 500
              },
              "credentialConfigured": {
                "type": "boolean"
              },
              "status": {
                "type": "string",
                "enum": [
                  "ACTIVE",
                  "DISABLED"
                ]
              },
              "connectTimeoutMs": {
                "type": "integer",
                "minimum": 1,
                "maximum": 600000
              },
              "readTimeoutMs": {
                "type": "integer",
                "minimum": 1,
                "maximum": 600000
              },
              "revision": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991,
                "description": "Monotonic compare-and-swap revision safe in JavaScript.",
                "examples": [
                  7
                ]
              }
            }
          }
        },
        "page": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "hasMore",
            "limit",
            "nextCursor"
          ],
          "properties": {
            "hasMore": {
              "type": "boolean"
            },
            "limit": {
              "type": "integer",
              "minimum": 1,
              "maximum": 200,
              "default": 50
            },
            "nextCursor": {
              "oneOf": [
                {
                  "type": "string",
                  "minLength": 16,
                  "maxLength": 512,
                  "pattern": "^[A-Za-z0-9_-]+$",
                  "description": "Server-signed opaque cursor."
                },
                {
                  "type": "null"
                }
              ]
            }
          }
        }
      }
    },
    "requestId": {
      "type": "string",
      "description": "Server-generated req_ prefix followed by one canonical ULID.",
      "pattern": "^req_[0-9A-HJKMNP-TV-Z]{26}$",
      "examples": [
        "req_01ARZ3NDEKTSV4RRFFQ69G5FAV"
      ]
    }
  }
}

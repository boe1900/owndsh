{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:enterprise-agent:contracts:ProviderProbeResponse",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "data",
    "requestId"
  ],
  "properties": {
    "data": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "success",
        "latencyMs",
        "upstreamStatus"
      ],
      "properties": {
        "success": {
          "type": "boolean"
        },
        "latencyMs": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "upstreamStatus": {
          "type": "string",
          "enum": [
            "SUCCESS",
            "AUTHENTICATION_FAILED",
            "UPSTREAM_REJECTED",
            "UNAVAILABLE",
            "TIMEOUT"
          ]
        }
      }
    },
    "requestId": {
      "type": "string",
      "description": "Server-generated req_ prefix followed by one canonical ULID.",
      "pattern": "^req_[0-9A-HJKMNP-TV-Z]{26}$",
      "examples": [
        "req_01ARZ3NDEKTSV4RRFFQ69G5FAV"
      ]
    }
  }
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:owndsh:contracts:IdentitySourceTestResponse",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "data",
    "requestId"
  ],
  "properties": {
    "data": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "ok",
        "diagnostic"
      ],
      "properties": {
        "type": {
          "type": "string",
          "enum": [
            "OIDC",
            "LDAP",
            "LOCAL"
          ]
        },
        "ok": {
          "type": "boolean"
        },
        "diagnostic": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        }
      }
    },
    "requestId": {
      "type": "string",
      "description": "Server-generated req_ prefix followed by one canonical ULID.",
      "pattern": "^req_[0-9A-HJKMNP-TV-Z]{26}$",
      "examples": [
        "req_01ARZ3NDEKTSV4RRFFQ69G5FAV"
      ]
    }
  }
}

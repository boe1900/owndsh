{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:owndsh:contracts:ModelGrantResponse",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "data",
    "requestId"
  ],
  "properties": {
    "data": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "resourceType",
        "resourceId",
        "resourceName",
        "subjectType",
        "subjects",
        "status",
        "revision",
        "createdAt",
        "updatedAt"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[1-9][0-9]{0,18}$"
        },
        "resourceType": {
          "type": "string",
          "enum": [
            "MODEL_SET",
            "MODEL"
          ]
        },
        "resourceId": {
          "type": "string",
          "pattern": "^[1-9][0-9]{0,18}$"
        },
        "resourceName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "subjectType": {
          "type": "string",
          "enum": [
            "ALL_MEMBERS",
            "ACCESS_GROUP",
            "MEMBER"
          ]
        },
        "subjects": {
          "type": "array",
          "minItems": 0,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "subjectId",
              "subjectName"
            ],
            "properties": {
              "subjectId": {
                "type": "string",
                "pattern": "^[1-9][0-9]{0,18}$"
              },
              "subjectName": {
                "type": "string",
                "minLength": 1,
                "maxLength": 120
              }
            }
          }
        },
        "status": {
          "type": "string",
          "enum": [
            "ACTIVE",
            "DISABLED"
          ]
        },
        "revision": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991,
          "description": "Monotonic compare-and-swap revision safe in JavaScript.",
          "examples": [
            7
          ]
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      }
    },
    "requestId": {
      "type": "string",
      "description": "Server-generated req_ prefix followed by one canonical ULID.",
      "pattern": "^req_[0-9A-HJKMNP-TV-Z]{26}$",
      "examples": [
        "req_01ARZ3NDEKTSV4RRFFQ69G5FAV"
      ]
    }
  }
}

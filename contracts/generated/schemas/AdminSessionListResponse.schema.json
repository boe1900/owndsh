{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:enterprise-agent:contracts:AdminSessionListResponse",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "data",
    "requestId"
  ],
  "properties": {
    "data": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "items",
        "page"
      ],
      "properties": {
        "items": {
          "type": "array",
          "maxItems": 200,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "replicaId",
              "sessionId",
              "ownerUserId",
              "ownerUsername",
              "sourceDeviceId",
              "sourceDeviceName",
              "formatVersion",
              "lastSeq",
              "eventCount",
              "status",
              "createdAt",
              "updatedAt",
              "deletedAt"
            ],
            "properties": {
              "replicaId": {
                "type": "string",
                "pattern": "^[1-9][0-9]{0,18}$"
              },
              "sessionId": {
                "type": "string",
                "minLength": 1,
                "maxLength": 128
              },
              "ownerUserId": {
                "type": "string",
                "pattern": "^[1-9][0-9]{0,18}$",
                "description": "Enterprise user snowflake ID serialized as a string."
              },
              "ownerUsername": {
                "type": "string",
                "minLength": 1,
                "maxLength": 30
              },
              "sourceDeviceId": {
                "type": "string",
                "pattern": "^[1-9][0-9]{0,18}$",
                "description": "Enterprise device snowflake ID serialized as a string."
              },
              "sourceDeviceName": {
                "type": "string",
                "minLength": 1,
                "maxLength": 120
              },
              "formatVersion": {
                "type": "integer",
                "const": 0
              },
              "lastSeq": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              },
              "eventCount": {
                "type": "integer",
                "minimum": 1,
                "maximum": 9007199254740991
              },
              "status": {
                "type": "string",
                "enum": [
                  "ACTIVE",
                  "DELETED",
                  "EXPIRED"
                ]
              },
              "createdAt": {
                "type": "string",
                "format": "date-time"
              },
              "updatedAt": {
                "type": "string",
                "format": "date-time"
              },
              "deletedAt": {
                "oneOf": [
                  {
                    "type": "string",
                    "format": "date-time"
                  },
                  {
                    "type": "null"
                  }
                ]
              }
            }
          }
        },
        "page": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "hasMore",
            "limit",
            "nextCursor"
          ],
          "properties": {
            "hasMore": {
              "type": "boolean"
            },
            "limit": {
              "type": "integer",
              "minimum": 1,
              "maximum": 200,
              "default": 50
            },
            "nextCursor": {
              "oneOf": [
                {
                  "type": "string",
                  "minLength": 16,
                  "maxLength": 512,
                  "pattern": "^[A-Za-z0-9_-]+$",
                  "description": "Server-signed opaque cursor."
                },
                {
                  "type": "null"
                }
              ]
            }
          }
        }
      }
    },
    "requestId": {
      "type": "string",
      "description": "Server-generated req_ prefix followed by one canonical ULID.",
      "pattern": "^req_[0-9A-HJKMNP-TV-Z]{26}$",
      "examples": [
        "req_01ARZ3NDEKTSV4RRFFQ69G5FAV"
      ]
    }
  }
}

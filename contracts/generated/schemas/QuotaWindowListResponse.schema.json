{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:enterprise-agent:contracts:QuotaWindowListResponse",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "data",
    "requestId"
  ],
  "properties": {
    "data": {
      "type": "array",
      "maxItems": 4,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "policyId",
          "windowType",
          "windowStart",
          "resetsAt",
          "limit",
          "usedTokens",
          "reservedTokens"
        ],
        "properties": {
          "policyId": {
            "type": "string",
            "pattern": "^[1-9][0-9]{0,18}$"
          },
          "windowType": {
            "type": "string",
            "enum": [
              "FIVE_HOURS",
              "DAY",
              "WEEK",
              "MONTH"
            ]
          },
          "windowStart": {
            "type": "string",
            "format": "date-time"
          },
          "resetsAt": {
            "type": "string",
            "format": "date-time"
          },
          "limit": {
            "type": "integer",
            "format": "int64",
            "minimum": 1
          },
          "usedTokens": {
            "type": "integer",
            "format": "int64",
            "minimum": 0
          },
          "reservedTokens": {
            "type": "integer",
            "format": "int64",
            "minimum": 0
          }
        }
      }
    },
    "requestId": {
      "type": "string",
      "description": "Server-generated req_ prefix followed by one canonical ULID.",
      "pattern": "^req_[0-9A-HJKMNP-TV-Z]{26}$",
      "examples": [
        "req_01ARZ3NDEKTSV4RRFFQ69G5FAV"
      ]
    }
  }
}

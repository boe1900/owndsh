{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:enterprise-agent:contracts:IdentitySourceResponse",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "data",
    "requestId"
  ],
  "properties": {
    "data": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "type",
        "name",
        "secretConfigured",
        "status",
        "revision",
        "createdAt",
        "updatedAt"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[1-9][0-9]{0,18}$",
          "description": "Identity source snowflake ID serialized as a string."
        },
        "type": {
          "type": "string",
          "enum": [
            "OIDC",
            "LDAP",
            "LOCAL"
          ]
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        },
        "issuer": {
          "type": "string",
          "format": "uri",
          "maxLength": 500
        },
        "clientId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 255
        },
        "oidc": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "scopes",
            "claims"
          ],
          "properties": {
            "scopes": {
              "type": "array",
              "minItems": 1,
              "maxItems": 32,
              "uniqueItems": true,
              "contains": {
                "const": "openid"
              },
              "items": {
                "type": "string",
                "minLength": 1,
                "maxLength": 128,
                "pattern": "^\\S+$"
              }
            },
            "claims": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "username",
                "displayName"
              ],
              "properties": {
                "username": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 128
                },
                "displayName": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 128
                },
                "email": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 128
                },
                "groups": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 128
                }
              }
            }
          }
        },
        "ldap": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "url",
            "baseDn",
            "managerDn",
            "userFilter",
            "stableIdAttribute",
            "usernameAttribute",
            "displayNameAttribute",
            "startTls"
          ],
          "properties": {
            "url": {
              "type": "string",
              "format": "uri",
              "maxLength": 500
            },
            "baseDn": {
              "type": "string",
              "minLength": 1,
              "maxLength": 512
            },
            "managerDn": {
              "type": "string",
              "minLength": 1,
              "maxLength": 512
            },
            "userFilter": {
              "type": "string",
              "minLength": 3,
              "maxLength": 512
            },
            "stableIdAttribute": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128
            },
            "usernameAttribute": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128
            },
            "displayNameAttribute": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128
            },
            "emailAttribute": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128
            },
            "groupAttribute": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128
            },
            "startTls": {
              "type": "boolean"
            }
          }
        },
        "secretConfigured": {
          "type": "boolean"
        },
        "status": {
          "type": "string",
          "enum": [
            "ACTIVE",
            "DISABLED"
          ]
        },
        "revision": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991,
          "description": "Monotonic compare-and-swap revision safe in JavaScript.",
          "examples": [
            7
          ]
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      }
    },
    "requestId": {
      "type": "string",
      "description": "Server-generated req_ prefix followed by one canonical ULID.",
      "pattern": "^req_[0-9A-HJKMNP-TV-Z]{26}$",
      "examples": [
        "req_01ARZ3NDEKTSV4RRFFQ69G5FAV"
      ]
    }
  }
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:enterprise-agent:contracts:ProtocolSuccessResponse",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "data",
    "requestId"
  ],
  "properties": {
    "data": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "contractVersion",
        "errorCodeCount",
        "status"
      ],
      "properties": {
        "contractVersion": {
          "type": "string",
          "const": "v1"
        },
        "errorCodeCount": {
          "type": "integer",
          "const": 36
        },
        "status": {
          "type": "string",
          "const": "ok"
        }
      }
    },
    "requestId": {
      "type": "string",
      "description": "Server-generated req_ prefix followed by one canonical ULID.",
      "pattern": "^req_[0-9A-HJKMNP-TV-Z]{26}$",
      "examples": [
        "req_01ARZ3NDEKTSV4RRFFQ69G5FAV"
      ]
    }
  }
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:owndsh:contracts:LdapDirectoryUserSearchResponse",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "data",
    "requestId"
  ],
  "properties": {
    "data": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "items"
      ],
      "properties": {
        "items": {
          "type": "array",
          "maxItems": 50,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "dn",
              "externalSubject",
              "username",
              "displayName",
              "email"
            ],
            "properties": {
              "dn": {
                "type": "string",
                "minLength": 1,
                "maxLength": 1024
              },
              "externalSubject": {
                "type": "string",
                "minLength": 1,
                "maxLength": 512
              },
              "username": {
                "type": "string",
                "minLength": 1,
                "maxLength": 128
              },
              "displayName": {
                "type": "string",
                "minLength": 1,
                "maxLength": 256
              },
              "email": {
                "oneOf": [
                  {
                    "type": "string",
                    "maxLength": 320
                  },
                  {
                    "type": "null"
                  }
                ]
              }
            }
          }
        }
      }
    },
    "requestId": {
      "type": "string",
      "description": "Server-generated req_ prefix followed by one canonical ULID.",
      "pattern": "^req_[0-9A-HJKMNP-TV-Z]{26}$",
      "examples": [
        "req_01ARZ3NDEKTSV4RRFFQ69G5FAV"
      ]
    }
  }
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:enterprise-agent:contracts:QuotaPolicyListResponse",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "data",
    "requestId"
  ],
  "properties": {
    "data": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "items",
        "page"
      ],
      "properties": {
        "items": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "name",
              "subjectType",
              "subjectId",
              "subjectName",
              "dailyTokenLimit",
              "monthlyTokenLimit",
              "rpm",
              "concurrency",
              "status",
              "revision"
            ],
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[1-9][0-9]{0,18}$"
              },
              "name": {
                "type": "string",
                "minLength": 1,
                "maxLength": 120
              },
              "subjectType": {
                "type": "string",
                "enum": [
                  "ORGANIZATION",
                  "MEMBER"
                ]
              },
              "subjectId": {
                "oneOf": [
                  {
                    "type": "string",
                    "pattern": "^[1-9][0-9]{0,18}$"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "subjectName": {
                "oneOf": [
                  {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 120
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "dailyTokenLimit": {
                "oneOf": [
                  {
                    "type": "integer",
                    "format": "int64",
                    "minimum": 1
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "monthlyTokenLimit": {
                "oneOf": [
                  {
                    "type": "integer",
                    "format": "int64",
                    "minimum": 1
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "rpm": {
                "oneOf": [
                  {
                    "type": "integer",
                    "minimum": 1
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "concurrency": {
                "oneOf": [
                  {
                    "type": "integer",
                    "minimum": 1
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "status": {
                "type": "string",
                "enum": [
                  "ACTIVE",
                  "DISABLED"
                ]
              },
              "revision": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991,
                "description": "Monotonic compare-and-swap revision safe in JavaScript.",
                "examples": [
                  7
                ]
              }
            }
          }
        },
        "page": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "hasMore",
            "limit",
            "nextCursor"
          ],
          "properties": {
            "hasMore": {
              "type": "boolean"
            },
            "limit": {
              "type": "integer",
              "minimum": 1,
              "maximum": 200,
              "default": 50
            },
            "nextCursor": {
              "oneOf": [
                {
                  "type": "string",
                  "minLength": 16,
                  "maxLength": 512,
                  "pattern": "^[A-Za-z0-9_-]+$",
                  "description": "Server-signed opaque cursor."
                },
                {
                  "type": "null"
                }
              ]
            }
          }
        }
      }
    },
    "requestId": {
      "type": "string",
      "description": "Server-generated req_ prefix followed by one canonical ULID.",
      "pattern": "^req_[0-9A-HJKMNP-TV-Z]{26}$",
      "examples": [
        "req_01ARZ3NDEKTSV4RRFFQ69G5FAV"
      ]
    }
  }
}

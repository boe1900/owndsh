# [INPUT]: 依赖 osixia/openldap 自带 dc=example,dc=org 与 admin DN。
# [OUTPUT]: 提供 Alice 测试用户、密码、邮件、部门属性和 OpenLDAP 自动 entryUUID。
# [POS]: T04 LDAP Testcontainer 的固定目录数据，不含任何生产身份或秘密。
# [PROTOCOL]: 变更时更新此头部，然后检查 CLAUDE.md

dn: ou=people,dc=example,dc=org
objectClass: organizationalUnit
ou: people

dn: uid=alice,ou=people,dc=example,dc=org
objectClass: inetOrgPerson
uid: alice
cn: Alice LDAP
sn: LDAP
mail: alice.ldap@example.org
ou: engineering
userPassword: ldap-password-73

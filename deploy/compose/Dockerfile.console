# [INPUT]: 依赖 console pnpm 锁、rc.3 原生资源、完整 OpenAPI 真源、BuildKit 构建平台，以及固定 glibc Node ≥24.15/Nginx 多架构镜像。
# [OUTPUT]: 在构建机原生平台生成静态资源，发布目标平台的非 root Nginx 镜像，语法校验后清除 root 创建的 pid 文件。
# [POS]: P2-08 唯一对外制品定义，浏览器和 Server 同域且不携带任何生产 secret。
# [PROTOCOL]: 变更时更新此头部，然后检查 CLAUDE.md

ARG OWNDSH_BASE_IMAGE_REGISTRY=docker.io/library
ARG OWNDSH_NODE_IMAGE=${OWNDSH_BASE_IMAGE_REGISTRY}/node:24.15.0-bookworm-slim@sha256:4e6b70dd6cbfc88c8157ba19aa3d9f9cce6ba4703576d55459e45efcbc9c5f5d
ARG OWNDSH_NGINX_IMAGE=${OWNDSH_BASE_IMAGE_REGISTRY}/nginx:1.28.0-alpine3.21@sha256:30f1c0d78e0ad60901648be663a710bdadf19e4c10ac6782c235200619158284
FROM --platform=$BUILDPLATFORM ${OWNDSH_NODE_IMAGE} AS build
WORKDIR /workspace/console
RUN npm install --global pnpm@11.24.0
COPY console/package.json console/pnpm-lock.yaml console/pnpm-workspace.yaml ./
COPY plugin/packages/contracts/ /workspace/plugin/packages/contracts/
COPY plugin/packages/remote-core/ /workspace/plugin/packages/remote-core/
COPY plugin/tsconfig.base.json /workspace/plugin/tsconfig.base.json
RUN pnpm install --frozen-lockfile
COPY console/ ./
COPY contracts/ /workspace/contracts/
RUN pnpm build

FROM ${OWNDSH_NGINX_IMAGE}
COPY deploy/nginx/nginx.conf /etc/nginx/nginx.conf
RUN sed -e 's/server owndsh-server:8080;/server 127.0.0.1:8080;/' \
        -e 's/server owndsh-server:8090;/server 127.0.0.1:8090;/' \
        /etc/nginx/nginx.conf > /tmp/nginx.conf \
    && nginx -t -c /tmp/nginx.conf \
    && rm /tmp/nginx.pid /tmp/nginx.conf
COPY --from=build /workspace/console/dist/ /usr/share/nginx/html/
USER 101:101
ENTRYPOINT []
CMD ["nginx", "-g", "daemon off;"]

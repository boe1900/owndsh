# [INPUT]: 依赖 admin-web 锁文件、生成 OpenAPI 真源、生产公开环境，以及默认 registry 或受验本地 RepoDigest 提供的固定 Node/Nginx 镜像。
# [OUTPUT]: 构建内含 React 静态资源与受审 Nginx TLS 配置的 Gateway 镜像。
# [POS]: T21 唯一公网制品定义，浏览器和 Server 同域且不携带任何生产 secret。
# [PROTOCOL]: 变更时更新此头部，然后检查 CLAUDE.md

ARG EAP_BASE_IMAGE_REGISTRY=docker.io/library
ARG EAP_NODE_IMAGE=${EAP_BASE_IMAGE_REGISTRY}/node:24.6.0-alpine3.22@sha256:51dbfc749ec3018c7d4bf8b9ee65299ff9a908e38918ce163b0acfcd5dd931d9
ARG EAP_NGINX_IMAGE=${EAP_BASE_IMAGE_REGISTRY}/nginx:1.28.0-alpine3.21@sha256:30f1c0d78e0ad60901648be663a710bdadf19e4c10ac6782c235200619158284
FROM ${EAP_NODE_IMAGE} AS build
WORKDIR /workspace/admin-web
RUN npm install --global pnpm@10.34.5
COPY admin-web/package.json admin-web/pnpm-lock.yaml ./
RUN pnpm install --frozen-lockfile
COPY admin-web/ ./
COPY contracts/generated/enterprise-openapi.json /workspace/contracts/generated/enterprise-openapi.json
RUN pnpm build:prod

FROM ${EAP_NGINX_IMAGE}
COPY deploy/nginx/nginx.conf /etc/nginx/nginx.conf
COPY --from=build /workspace/admin-web/dist/ /usr/share/nginx/html/
USER 101:101
ENTRYPOINT []
CMD ["nginx", "-g", "daemon off;"]

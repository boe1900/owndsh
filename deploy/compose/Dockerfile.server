# [INPUT]: 依赖仓库 server 源码、Maven lock，以及默认 registry 或受验本地 RepoDigest 提供的固定 Maven 与 Jammy/glibc JRE Linux 镜像。
# [OUTPUT]: 构建只含可执行 owndsh-server.jar 的非 root Java 21 Server 镜像，避免 Alpine/musl AWT 验证码原生崩溃。
# [POS]: T21 Server 生产制品定义，migration 和 application-deploy.yml 随 JAR 同版交付。
# [PROTOCOL]: 变更时更新此头部，然后检查 CLAUDE.md

ARG OWNDSH_BASE_IMAGE_REGISTRY=docker.io/library
ARG OWNDSH_MAVEN_IMAGE=${OWNDSH_BASE_IMAGE_REGISTRY}/maven:3.9.11-eclipse-temurin-21-alpine@sha256:922927df2c662cdd47ddb116443d6bec4696cfae3de1a0ddac8fcc7b87ce61ae
ARG OWNDSH_JRE_IMAGE=${OWNDSH_BASE_IMAGE_REGISTRY}/eclipse-temurin:21.0.8_9-jre-jammy@sha256:cddd554e8d69b48b46e8b0c9d1ce72ae5fe8d84819dcdb7131328531e9cc100b
FROM ${OWNDSH_MAVEN_IMAGE} AS build
WORKDIR /workspace/server
COPY server/ ./
RUN mvn -B -ntp -Pprod -DskipTests -pl owndsh-server -am package

FROM ${OWNDSH_JRE_IMAGE}
RUN groupadd --system --gid 10001 enterprise \
    && useradd --system --uid 10001 --gid 10001 --no-create-home enterprise \
    && mkdir -p /app/logs /app/tmp /var/lib/enterprise/artifacts \
    && chown -R 10001:10001 /app /var/lib/enterprise
WORKDIR /app
COPY --from=build --chown=10001:10001 /workspace/server/owndsh-server/target/owndsh-server.jar /app/app.jar
USER 10001:10001
EXPOSE 8080
CMD ["java", "-Djava.security.egd=file:/dev/urandom", "-jar", "/app/app.jar"]

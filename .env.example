# [INPUT]: 依赖仓库根 Docker Compose、公开 GHCR 测试镜像与本地绝对状态目录。
# [OUTPUT]: 提供不含秘密的 Compose 部署参数模板。
# [POS]: 源码部署的公开环境变量入口；密码和密钥只存在于 OWNDSH_STATE_DIR/secrets。
# [PROTOCOL]: 变更时更新此头部，然后检查 CLAUDE.md

OWNDSH_STATE_DIR=${PWD}/.owndsh
OWNDSH_RELEASE_VERSION=next
OWNDSH_SERVER_IMAGE=ghcr.io/boe1900/owndsh-server:next
OWNDSH_CONSOLE_IMAGE=ghcr.io/boe1900/owndsh-console:next
OWNDSH_POSTGRES_BASELINE=${PWD}/server/script/sql/postgres/postgres_owndsh.sql
OWNDSH_COMPOSE_PROJECT_NAME=owndsh
OWNDSH_HTTP_BIND=0.0.0.0
OWNDSH_HTTP_PORT=8080

ENT_PUBLIC_BASE_URL=http://localhost:8080
ENT_ADMIN_REDIRECT_URI=http://localhost:8080/enterprise/auth/callback
ENT_DEPLOYMENT_TIME_ZONE=Asia/Shanghai
ENT_POSTGRES_DATABASE=owndsh
ENT_POSTGRES_USERNAME=owndsh

ENT_BOOTSTRAP_ADMIN_USERNAME=platform.admin
OWNDSH_BOOTSTRAP_PASSWORD_FILE=${PWD}/.owndsh/secrets/bootstrap_admin_password

# [INPUT]: 依赖仓库根 Docker Compose 内置默认值与阿里云 ACR 测试镜像。
# [OUTPUT]: 提供可选的 Compose 覆盖模板，所有凭据与运行参数均使用环境变量。
# [POS]: 源码部署的可选配置入口；不复制也能启动，生产部署必须替换全部 secret。
# [PROTOCOL]: 变更时更新此头部，然后检查 CLAUDE.md

OWNDSH_SERVER_IMAGE=registry.cn-hangzhou.aliyuncs.com/cola1900/owndsh-server:next
OWNDSH_CONSOLE_IMAGE=registry.cn-hangzhou.aliyuncs.com/cola1900/owndsh-console:next
OWNDSH_COMPOSE_PROJECT_NAME=owndsh
OWNDSH_HTTP_BIND=0.0.0.0
OWNDSH_HTTP_PORT=8080

# 默认地址由 Compose 生成为 http://localhost:8080；跨设备访问时改成部署机实际 IP，例如：
# ENT_PUBLIC_BASE_URL=http://192.168.1.50:8080
ENT_DEPLOYMENT_TIME_ZONE=Asia/Shanghai
ENT_POSTGRES_DATABASE=owndsh
ENT_POSTGRES_USERNAME=owndsh
ENT_POSTGRES_PASSWORD=owndsh
ENT_REDIS_PASSWORD=owndsh
SA_TOKEN_JWT_SECRET_KEY=owndsh-jwt-secret-change-me-000000000000000000000000
ENT_MASTER_KEY=0123456789abcdef0123456789abcdef

ENT_BOOTSTRAP_ADMIN_USERNAME=admin
# 仅首次登录使用，可自由修改；首次登录后必须设置正式密码。
ENT_BOOTSTRAP_ADMIN_PASSWORD=owndsh

# Remote carrier 默认关闭；启用后由 Console 同源入口代理 WebSocket 到 Server:8090。
ENT_REMOTE_ENABLED=false
ENT_REMOTE_ALLOWED_ORIGIN=
# 逗号分隔的 STUN/TURN URL；TURN 必须同时设置 coturn shared secret。
ENT_REMOTE_ICE_SERVER_URLS=
ENT_REMOTE_TURN_SHARED_SECRET=

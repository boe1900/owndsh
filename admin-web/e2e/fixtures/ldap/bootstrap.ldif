# [INPUT]: 依赖 osixia/openldap 首次 bootstrap 与 candidate.test base DN。
# [OUTPUT]: 提供固定 Alice/Bob inetOrgPerson 条目及可直接读取的业务组属性。
# [POS]: T22 LDAP 协议夹具，值均为测试身份且不复用平台或企业生产凭据。
# [PROTOCOL]: 变更时更新此头部，然后检查 CLAUDE.md

dn: ou=people,dc=candidate,dc=test
objectClass: organizationalUnit
ou: people

dn: uid=candidate-alice,ou=people,dc=candidate,dc=test
objectClass: inetOrgPerson
uid: candidate-alice
cn: Candidate Alice
sn: Alice
displayName: Candidate Alice
mail: alice@candidate.test
employeeNumber: candidate-ldap-alice
businessCategory: engineering
userPassword: CandidateAlice!42

dn: uid=candidate-bob,ou=people,dc=candidate,dc=test
objectClass: inetOrgPerson
uid: candidate-bob
cn: Candidate Bob
sn: Bob
displayName: Candidate Bob
mail: bob@candidate.test
employeeNumber: candidate-ldap-bob
businessCategory: unassigned
userPassword: CandidateBob!42
